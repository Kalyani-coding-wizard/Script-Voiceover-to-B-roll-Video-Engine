# =============================================================================
# IncuBrix B-roll Video Engine — Environment Variables
# Copy this file to .env and fill in all required values before running.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL via asyncpg)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://broll:broll@postgres:5432/broll

# ---------------------------------------------------------------------------
# Queue / Cache (Redis)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9090
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=broll-outputs
S3_REGION=us-east-1
# auto: use S3/MinIO when available, otherwise retain local artifacts
# local: force local/mock storage
# s3: require S3/MinIO (operations fall back locally if unavailable)
ARTIFACT_BACKEND=auto

# ---------------------------------------------------------------------------
# Footage providers  (at least one API key required)
# ---------------------------------------------------------------------------
# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# fal.ai — used for AI-generated footage / image-to-video
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# Which footage provider to use by default: pexels | pixabay | fal
FOOTAGE_PROVIDER=pexels

# ---------------------------------------------------------------------------
# Text-to-Speech provider
# TTS_PROVIDER: edge | openai
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge

# ---------------------------------------------------------------------------
# LLM provider
# LLM_PROVIDER: gemini | openai
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# OpenAI API key (required when LLM_PROVIDER=openai or TTS_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini API key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Audio / job limits
# ---------------------------------------------------------------------------
# Maximum allowed voiceover duration in seconds
MAX_AUDIO_DURATION=600
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# ARQ worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HMAC secret used to sign upload / download URLs — CHANGE IN PRODUCTION
HMAC_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Logging & debug
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# Set to true to skip real API calls and return mock responses (for testing)
MOCK_MODE=false

# Optional production artifact storage: auto, local, or s3.
ARTIFACT_BACKEND=auto
